# Supabase — project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Maps JS API key (Maps JavaScript, Places, Geocoding enabled)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-browser-key

# Twilio — optional, only needed for SMS invites
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
